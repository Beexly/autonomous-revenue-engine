# Copy to tools/.env and fill in what you need. `.env` is gitignored at the
# repo root. Never commit real values; never pass them on a command line.
# Rotate immediately if a value is ever pasted into a chat, a log or a
# screenshot.

# --- OpenRouter (the default provider) ------------------------------------
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Higgsfield (optional second provider) --------------------------------
# https://console.higgsfield.ai — a credential is an ID and a secret, sent
# together as `Authorization: Key ID:SECRET`.
# https://docs.higgsfield.ai/docs/authentication
HF_API_KEY_ID=
HF_API_KEY_SECRET=
