# Copy to tools/.env and fill in. `.env` is gitignored at the repo root.
# Never commit real values; never pass them on a command line.
#
# Create a key pair at https://console.higgsfield.ai — each credential is an
# ID and a secret, sent together as `Authorization: Key ID:SECRET`.
# Rotate immediately if either half is ever pasted into a chat, a log or a
# screenshot: https://docs.higgsfield.ai/docs/authentication
HF_API_KEY_ID=
HF_API_KEY_SECRET=
